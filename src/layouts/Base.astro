---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import { ClientRouter } from 'astro:transitions';
import SeaScene from '../components/stage/SeaScene.svelte';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/everything". Joined to `site` for canonical. */
  path?: string;
  /** Keep this page out of search engines (a preview). */
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://example.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? 'https://example.com').href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Matches the page, so the browser chrome does not flash. */}
    <meta name="theme-color" content="#070b18" />
    {/* Lets CSS hold back entrance effects only when script is running,
        so nothing is hidden for anyone it cannot reach. */}
    <script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>

    {/* Pages change without a reload, so the sea behind them never restarts. */}
    <ClientRouter />

  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SeaScene client:load transition:persist />
    <slot />
  </body>
</html>

<script>
  import { initSmoothScroll, landOnHash, restoreTo } from '../lib/motion/smooth';
  import { watchPlace, wasReload, savedPlace } from '../lib/motion/keep-place';
  import { smoothDisclosures } from '../lib/motion/disclosure';

  watchPlace();
  smoothDisclosures();
  // Only the very first page of a refreshed tab is a reload; later page
  // changes happen inside the same document.
  let firstLoad = true;

  // Runs on the first load and after every page change: the scroll engine is
  // rebuilt for the new page, and a link that arrived with #id glides there.
  let stop: (() => void) | null = null;
  let cancelLand: (() => void) | null = null;
  let run = 0;

  document.addEventListener('astro:page-load', async () => {
    const mine = ++run;
    const cleanup = await initSmoothScroll();
    if (mine !== run) return cleanup?.();
    stop = cleanup;
    const place = firstLoad && wasReload() ? savedPlace() : null;
    firstLoad = false;
    cancelLand = place !== null ? restoreTo(place) : landOnHash();
  });

  document.addEventListener('astro:before-swap', () => {
    run++;
    cancelLand?.();
    stop?.();
    stop = null;
  });
</script>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: var(--s-4);
    z-index: 100;
    padding: var(--s-2) var(--s-4);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--dur) var(--ease);
  }
  .skip:focus-visible { transform: translateY(0); }
</style>
