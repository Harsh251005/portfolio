---
/* The whole site, flat.

   Three jobs: the visitor in a hurry who wants to skim, the visitor
   with JavaScript off, and search engines — which cannot tap a chip
   and would otherwise see an almost empty page. */
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import StaticAnswer from '../components/StaticAnswer.astro';
import { loadGrouped } from '../lib/knowledge';
import { OWNER } from '../lib/links';

const groups = await loadGrouped();
const total = groups.reduce((n, g) => n + g.entries.length, 0);
---

<Base
  title={`Everything — ${OWNER.name}`}
  description={`Every answer on the site, in one page. ${OWNER.tagline}`}
  path="/everything"
>
  <div class="page" id="main">
    <header class="head">
      <p class="label"><a href="/">← Back to the start</a></p>
      <h1>Everything I can tell you</h1>
      <p class="sub">
        All {total} answers, in order, on one page. The version of this site
        that talks back is <a href="/">over here</a>.
      </p>
    </header>

    <nav class="toc" aria-label="Contents">
      {groups.map((group) => (
        <section>
          <p class="label">{group.label}</p>
          <ul>
            {group.entries.map((entry) => (
              <li><a href={`#${entry.id}`}>{entry.short}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </nav>

    {groups.map((group) => (
      <section class="group">
        <h2 class="group__title">{group.label}</h2>
        {group.entries.map((entry) => <StaticAnswer entry={entry} />)}
      </section>
    ))}
  </div>

  <Footer />
</Base>

<style>
  .head { padding-top: clamp(var(--s-7), 8vh, var(--s-9)); padding-bottom: var(--s-6); }

  h1 {
    margin-top: var(--s-4);
    font-size: var(--t-3xl);
    font-variation-settings: 'opsz' var(--opsz-display), 'wght' 300;
    letter-spacing: -0.03em;
  }

  .sub { margin-top: var(--s-4); font-size: var(--t-lg); color: var(--ink-soft); }
  .sub a, .head a { color: var(--accent); }

  .toc {
    padding-block: var(--s-6);
    border-block: var(--hairline) solid var(--rule);
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .toc ul { list-style: none; padding: 0; margin-top: var(--s-2); display: grid; gap: var(--s-1); }
  .toc a { font-size: var(--t-sm); color: var(--ink-soft); }
  .toc a:hover { color: var(--accent); }

  .group { padding-top: var(--section); }

  .group__title {
    font-size: var(--t-xs);
    font-family: var(--font-body);
    font-variation-settings: 'wght' 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
