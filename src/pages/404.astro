---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { OWNER } from '../lib/links';

---

<Base title={`Not here — ${OWNER.name}`} description="That page doesn't exist." path="/404">
  <div class="page wrap" id="main">
    <p class="label">404</p>
    <h1>That page isn't here.</h1>
    <p class="sub">This site is one page, and you just missed it.</p>
    <a class="home" href="/">→ Go to the page</a>
  </div>

  <Footer />
</Base>

<style>
  .wrap { padding-block: clamp(var(--s-8), 18vh, 12rem); }

  h1 {
    margin-top: var(--s-4);
    font-size: var(--t-3xl);
    font-variation-settings: 'wght' 560;
    letter-spacing: -0.03em;
  }

  .sub { margin-top: var(--s-4); font-size: var(--t-lg); color: var(--ink-soft); }

  .home {
    margin-top: var(--s-5);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--t-lg);
    color: var(--ink);
  }
  @media (hover: hover) { .home:hover { color: var(--accent); } }
</style>
