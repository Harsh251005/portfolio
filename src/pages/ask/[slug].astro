---
/* One page per entry, in the same world as the home page.

   The ribbon runs calm behind it, the entry reads off one glass
   panel, and related entries are offered as tiles at the end.
   Static apart from the ribbon and a project's diagram. */
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import StaticAnswer from '../../components/StaticAnswer.astro';
import Ribbon from '../../components/stage/Ribbon.svelte';
import Example from '../../components/stage/Example.svelte';
import { loadEntries, GROUP_LABELS } from '../../lib/knowledge';
import { OWNER } from '../../lib/links';

export async function getStaticPaths() {
  const { loadEntries } = await import('../../lib/knowledge');
  const entries = await loadEntries();
  return entries
    .filter((entry) => !entry.hidden)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const all = await loadEntries();
const followups = entry.followups
  .map((id: string) => all.find((e) => e.id === id))
  .filter(Boolean);

const section = GROUP_LABELS[entry.group as keyof typeof GROUP_LABELS] ?? '';

// The first thing a reader sees, for the search result snippet.
const description = (entry.moment ?? entry.plain ?? entry.text).slice(0, 155).trim();
---

<Base
  title={`${entry.question} — ${OWNER.name}`}
  description={description || OWNER.tagline}
  path={`/ask/${entry.id}`}
>
  <Ribbon client:load />

  <div class="layer">
    <div class="page wrap" id="main">
      <a class="back" href="/">
        <span aria-hidden="true">←</span> {OWNER.name}
      </a>

      <header class="head">
        <p class="label"><span class="bar" aria-hidden="true"></span>{section}</p>
        <h1>{entry.question}</h1>
      </header>

      <article class="glass panel">
        <StaticAnswer entry={entry} />

        {entry.example && (
          <div class="diagram">
            <Example example={entry.example} note={entry.note} active={true} />
          </div>
        )}

        {entry.link && (
          <a class="repo" href={entry.link} rel="noreferrer noopener">
            How it's built <span aria-hidden="true">↗</span>
          </a>
        )}
      </article>

      {followups.length > 0 && (
        <nav class="next" aria-label="Keep reading">
          <p class="label"><span class="bar" aria-hidden="true"></span>Keep reading</p>
          <ul>
            {followups.map((next: any) => (
              <li>
                <a class="glass tile" href={`/ask/${next.id}`}>
                  <span class="tile__kicker">{next.short}</span>
                  <span class="tile__title">{next.question}</span>
                  <span class="tile__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <Footer />
  </div>
</Base>

<style>
  /* Above the fixed ribbon, which sits at z-index 0. */
  .layer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .wrap { padding-bottom: var(--section); }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-top: var(--s-6);
    padding-inline: var(--s-4);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 320ms var(--ease), border-color 320ms var(--ease);
  }

  .back:hover { color: var(--accent); border-color: var(--accent); }

  .head { margin-top: clamp(var(--s-7), 10vh, var(--s-9)); }

  .label { display: flex; align-items: center; gap: var(--s-3); }
  .bar { width: 2rem; height: 1px; background: var(--accent); }

  h1 {
    margin-top: var(--s-4);
    font-size: var(--t-3xl);
    font-variation-settings: 'opsz' var(--opsz-display), 'wght' 400;
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  .panel {
    margin-top: var(--s-7);
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .diagram { margin-top: var(--s-7); }

  .repo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-top: var(--s-6);
    padding-inline: var(--s-5);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: border-color 320ms var(--ease), background 320ms var(--ease);
  }

  .repo:hover {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }

  .next { margin-top: var(--s-8); }

  .next ul {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--s-4);
  }

  .tile {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-2) var(--s-4);
    height: 100%;
    padding: var(--s-5);
    color: var(--ink);
    text-decoration: none;
    transition: transform 520ms var(--ease-out), border-color 520ms var(--ease);
  }

  .tile:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, 0.16); }

  .tile__kicker {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tile__title {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-variation-settings: 'opsz' var(--opsz-display), 'wght' 400;
    line-height: var(--leading-snug);
  }

  .tile__arrow {
    align-self: end;
    transition: transform 420ms var(--ease-out);
  }

  .tile:hover .tile__arrow { transform: translateX(6px); }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover { transform: none; }
  }
</style>
