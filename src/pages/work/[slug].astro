---
/* One page per project: /work/<id>. The card copy comes from the project's
   knowledge entry, the numbers, tools and demo from src/content/projects/<id>.md,
   and the write-up is that file's Markdown body. Add a project by adding
   both files; nothing here changes (a new kind of demo needs one component). */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Band from '../../components/stage/Band.astro';
import Footer from '../../components/Footer.astro';
import CallDemo from '../../components/work/CallDemo.svelte';
import FixLoopDemo from '../../components/work/FixLoopDemo.svelte';
import RetrievalDemo from '../../components/work/RetrievalDemo.svelte';
import { loadEntries } from '../../lib/knowledge';
import { OWNER } from '../../lib/links';

export async function getStaticPaths() {
  const entries = (await loadEntries())
    .filter((entry) => entry.card === 'project')
    .sort((a, b) => a.order - b.order);
  const details = await getCollection('projects');

  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      detail: details.find((d) => d.id === entry.id) ?? null,
      next: entries[(i + 1) % entries.length],
      index: i,
      total: entries.length,
    },
  }));
}

const { entry, detail, next, index, total } = Astro.props;
const Content = detail ? (await render(detail)).Content : null;
const demo = detail?.data.demo;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${entry.tagline ?? entry.short} — ${OWNER.name}`}
  description={entry.plain ?? OWNER.tagline}
  path={`/work/${entry.id}`}
>
  <main id="main">
    <Band flush>
      <div class="page head">
        <a class="back" href="/#work"><span aria-hidden="true">←</span> Back to the work</a>

        {/* The clicked card on the home page grows into this panel. */}
        <section class="panel glass" style={`view-transition-name: proj-${entry.id}`}>
          <p class="label">Project {pad(index + 1)} of {pad(total)}</p>
          <h1>{entry.tagline ?? entry.short}</h1>
          {entry.moment && <p class="moment">{entry.moment}</p>}
          {entry.plain && <p class="plain">{entry.plain}</p>}

          <div class="meta">
            {detail && detail.data.stack.length > 0 && (
              <ul class="stack" aria-label="Built with">
                {detail.data.stack.map((tool) => <li>{tool}</li>)}
              </ul>
            )}
            {entry.link && (
              <a class="code" href={entry.link} rel="noreferrer noopener">
                See the code on GitHub <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </section>
      </div>
    </Band>

    {demo && (
      <Band flush class="demo-band">
        <section class="page rise" style="--i: 1" aria-labelledby="demo-title">
          <p class="label">See it work</p>
          <h2 id="demo-title">{demo.title}</h2>
          <p class="lead">{demo.lead}</p>
          <div class="stage">
            {demo.kind === 'call' && <CallDemo client:visible />}
            {demo.kind === 'loop' && <FixLoopDemo client:visible />}
            {demo.kind === 'retrieval' && <RetrievalDemo client:visible />}
          </div>
        </section>
      </Band>
    )}

    {detail && detail.data.facts.length > 0 && (
      <Band flush class="facts-band">
        <ul class="page facts rise" style="--i: 2">
          {detail.data.facts.map((fact) => (
            <li class="glass">
              <p class="value">{fact.value}</p>
              <p class="what">{fact.label}</p>
            </li>
          ))}
        </ul>
      </Band>
    )}

    <Band flush class="body-band">
      <div class="page rise" style="--i: 3">
        <article class="glass article prose">
          <div class="story" set:html={entry.html} />
          {Content && <div class="detail"><Content /></div>}
        </article>
      </div>
    </Band>

    <Band flush class="next-band">
      <nav class="page next rise" style="--i: 4" aria-label="More work">
        <a class="more" href={`/work/${next.id}`}>
          <span class="label">Next project</span>
          <span class="title">{next.tagline ?? next.short} <span aria-hidden="true">→</span></span>
        </a>
        <a class="more" href="/#contact">
          <span class="label">Like what you see?</span>
          <span class="title">Let's talk <span aria-hidden="true">→</span></span>
        </a>
      </nav>
    </Band>
  </main>

  <Footer />
</Base>

<style is:global>
  body { display: flex; flex-direction: column; }
</style>

<style>
  .head { padding-top: clamp(5rem, 13vh, 8rem); }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    margin-bottom: var(--s-4);
    font-size: var(--t-sm);
    color: var(--ink-soft);
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }

  .panel { padding: var(--s-6); }

  h1 {
    margin-top: var(--s-4);
    font-size: clamp(2.25rem, 4.6vw + 1rem, 5rem);
    font-variation-settings: 'wght' 560;
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }

  .moment {
    margin-top: var(--s-6);
    max-width: 36ch;
    font-size: var(--t-xl);
    line-height: 1.3;
    font-style: italic;
    color: var(--ink);
  }

  .plain {
    margin-top: var(--s-4);
    max-width: 44ch;
    font-size: var(--t-lg);
    color: var(--ink-soft);
  }

  .meta {
    margin-top: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .stack li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: rgba(7, 11, 24, 0.55);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .code {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    font-variation-settings: 'wght' 600;
    font-size: var(--t-sm);
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.3em;
  }
  .code:hover { color: var(--accent); }

  /* ---------- the page arrives in order ---------- */

  .rise { animation: arrive 720ms var(--ease-out) both; animation-delay: calc(var(--i, 0) * 110ms + 250ms); }
  @keyframes arrive { from { opacity: 0; transform: translateY(26px); } }
  @media (prefers-reduced-motion: reduce) { .rise { animation: none; } }

  /* ---------- the demo ---------- */

  :global(.band.demo-band) { padding-top: var(--s-8); }

  :global(.demo-band) h2 {
    margin-top: var(--s-4);
    font-size: clamp(2rem, 4vw + 1rem, 4rem);
    font-variation-settings: 'wght' 560;
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .lead { margin-top: var(--s-4); max-width: 52ch; font-size: var(--t-lg); color: var(--ink-soft); }
  .stage { margin-top: var(--s-6); }

  /* ---------- the three facts ---------- */

  :global(.band.facts-band) { padding-top: var(--s-8); }

  .facts {
    list-style: none;
    margin-block: 0;
    padding-block: 0;
    display: grid;
    gap: var(--s-4);
  }

  .facts li { padding: var(--s-5); display: flex; flex-direction: column; gap: var(--s-2); }

  .value {
    font-size: var(--t-2xl);
    font-variation-settings: 'wght' 560;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .what { font-size: var(--t-sm); line-height: 1.45; color: var(--ink-soft); }

  /* ---------- the write-up ---------- */

  :global(.band.body-band) { padding-top: var(--s-7); }

  .article { padding: var(--s-6); }

  .article :global(h2) {
    margin-top: var(--s-6);
    font-size: var(--t-xl);
    font-variation-settings: 'wght' 560;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .article :global(.detail > h2:first-child) { margin-top: 0; }
  .article :global(.story + .detail) { margin-top: var(--s-6); padding-top: var(--s-2); border-top: 1px solid var(--rule); }
  .article :global(img) { max-width: 100%; height: auto; border-radius: var(--radius); }
  .article :global(.prose > * + *), .article :global(.story > * + *), .article :global(.detail > * + *) { margin-top: var(--s-4); }
  .article :global(p), .article :global(ul), .article :global(ol) { max-width: 62ch; }

  /* ---------- where next ---------- */

  :global(.band.next-band) { padding-block: var(--s-7) var(--section); }

  .next { display: grid; gap: var(--s-4); }

  .more {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border-top: 3px solid var(--accent);
    background: rgba(9, 16, 34, 0.76);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 320ms var(--ease), transform 320ms var(--ease-out);
  }
  .more:hover { background: rgba(26, 38, 68, 0.85); transform: translateY(-3px); }
  .more .title { font-size: var(--t-xl); font-variation-settings: 'wght' 560; letter-spacing: -0.02em; }

  @media (width >= 48rem) {
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .next { grid-template-columns: 1fr 1fr; }
    .article { padding: var(--s-7); }
    .panel { padding: var(--s-7); }
  }
</style>
