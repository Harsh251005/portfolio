---
/* How a project is built, read in one glance: the path its work travels,
   one step per stop, each with a line in plain words and the tools behind it.
   A light runs along the line to show the direction. Data comes from the
   `build` list in src/content/projects/<id>.md; nothing here is per-project. */
interface Step { step: string; does: string; tools: string[] }
interface Props { steps: Step[] }
const { steps } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="strip" style={`--n: ${steps.length}`}>
  {steps.map((s, i) => (
    <li class="stop" style={`--k: ${i}`}>
      <span class="node" aria-hidden="true"><span class="num">{pad(i + 1)}</span></span>
      <div class="body">
        <h3 class="name">{s.step}</h3>
        <p class="does">{s.does}</p>
        {s.tools.length > 0 && (
          <ul class="tools" aria-label="Tools">
            {s.tools.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .strip {
    --dot: 2.4rem;
    --gap: var(--s-5);
    --beat: 1.1s; /* time the light takes from one stop to the next */
    list-style: none;
    margin: 0;
    padding: var(--s-5);
    display: grid;
    gap: var(--gap);
  }

  .stop { position: relative; display: grid; grid-template-columns: var(--dot) 1fr; gap: var(--s-4); align-items: start; align-content: start; }

  /* The line from this stop to the next, and the light that runs along it,
     one connector after another, so the eye follows the work in order. */
  .stop:not(:last-child)::before,
  .stop:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 0.5px);
    top: var(--dot);
    width: 1px;
    height: calc(100% + var(--gap) - var(--dot));
    background: var(--rule);
  }
  .stop:not(:last-child)::after {
    background: linear-gradient(to bottom, transparent, var(--accent), transparent) no-repeat;
    background-size: 100% 45%;
    background-position: 0 -60%;
    animation: run-down calc(var(--beat) * var(--n)) linear infinite;
    animation-delay: calc(var(--k) * var(--beat));
  }

  .node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    border: 1px solid var(--accent-soft);
    background: rgba(7, 11, 24, 0.9);
    animation: glow calc(var(--beat) * var(--n)) ease-in-out infinite;
    animation-delay: calc(var(--k) * var(--beat));
  }
  .num { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--accent); }

  .body { display: grid; gap: var(--s-2); padding-top: 0.35rem; align-content: start; }
  .name { font-size: var(--t-lg); font-variation-settings: 'wght' 580; letter-spacing: -0.015em; line-height: 1.2; color: var(--ink); }
  .does { font-size: var(--t-sm); line-height: 1.45; color: var(--ink-soft); max-width: 34ch; }

  .tools { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.15rem; }
  .tools li {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    letter-spacing: 0.05em;
    color: var(--ink);
    background: rgba(7, 11, 24, 0.5);
  }

  /* The light crosses its connector in the first beat of the cycle, then rests.
     20% = one beat of five stops; keyframes can't read --n, so change it with the count. */
  @keyframes run-down { 0% { background-position: 0 -60%; } 20%, 100% { background-position: 0 160%; } }
  @keyframes run-across { 0% { background-position: -60% 0; } 20%, 100% { background-position: 160% 0; } }
  @keyframes glow {
    0%, 22%, 100% { border-color: var(--accent-soft); box-shadow: none; }
    6% { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent), 0 0 16px color-mix(in oklab, var(--accent) 60%, transparent); }
  }

  /* Wide screens: the path runs left to right. */
  @media (width >= 60rem) {
    .strip { --gap: var(--s-4); grid-template-columns: repeat(var(--n), minmax(0, 1fr)); padding: var(--s-6); }
    .stop { grid-template-columns: 1fr; gap: var(--s-4); }
    .stop:not(:last-child)::before,
    .stop:not(:last-child)::after {
      left: var(--dot);
      top: calc(var(--dot) / 2 - 0.5px);
      width: calc(100% + var(--gap) - var(--dot));
      height: 1px;
    }
    .stop:not(:last-child)::after {
      background: linear-gradient(to right, transparent, var(--accent), transparent) no-repeat;
      background-size: 45% 100%;
      background-position: -60% 0;
      animation-name: run-across;
    }
    .body { padding-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop::after { display: none; }
    .node { animation: none; }
  }
</style>
