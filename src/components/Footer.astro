---
/* Sitewide footer. Links live in one place — src/lib/links.ts —
   so they are never duplicated across pages. */
import { LINKS, OWNER } from '../lib/links';
---

<footer class="foot">
  <div class="page inner">
    <p class="name">{OWNER.name}</p>

    <nav aria-label="Elsewhere">
      <ul class="touch-list">
        {LINKS.map((link) => (
          <li>
            {link.href ? (
              <a href={link.href} rel={link.external ? 'noreferrer noopener me' : undefined}>
                {link.label}
              </a>
            ) : (
              <span class="todo" title="Add this in src/lib/links.ts">{link.label} ⟨missing⟩</span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <p class="year">{new Date().getFullYear()}</p>
  </div>
</footer>


<style>
  .foot {
    padding-block: var(--s-6);
    margin-top: auto;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    border-top: 1.5px solid var(--ink);
    padding-top: var(--s-5);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--t-base);
    color: var(--ink);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    font-size: var(--t-sm);
  }

  a { color: var(--ink); }
  a:hover { color: var(--accent); }

  .year {
    font-family: var(--font-body);
    font-size: var(--t-xs);
    color: var(--ink-faint);
  }
</style>
