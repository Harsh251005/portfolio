---
/* Sitewide footer, and the one place on the site with the ways to reach
   me. Links live in src/lib/links.ts so they are never duplicated. */
import { LINKS, OWNER } from '../lib/links';

/* Brand marks are filled, as their owners draw them; the envelope is a line. */
/** Email shows the address itself, so it's useful without a mail app. */
const shown = (link: { label: string; href: string | null }) =>
  link.label === 'Email' ? link.href!.replace('mailto:', '') : link.label;

const ICONS: Record<string, { d: string; filled: boolean }> = {
  Email: { d: 'M2 5h20v14H2zM2 6l10 7 10-7', filled: false },
  GitHub: {
    d: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
    filled: true,
  },
  Resume: { d: 'M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8', filled: false },
  LinkedIn: {
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    filled: true,
  },
};
---

<footer class="foot">
  <div class="page inner">
    <nav aria-label="Ways to reach me">
      <ul>
        {LINKS.map((link, i) => (
          <li>
            {link.href ? (
              <a class:list={['btn', { primary: i === 0 }]} href={link.href} rel={link.external ? 'noreferrer noopener me' : undefined}>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" {...(ICONS[link.label].filled ? { fill: 'currentColor' } : { fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' })}>
                  <path d={ICONS[link.label].d} />
                </svg>
                <span class="text">{shown(link)}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="todo" title="Add this in src/lib/links.ts">{link.label} ⟨missing⟩</span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="line">
      <p>{OWNER.name}</p>
      <p>{new Date().getFullYear()}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: var(--s-5) var(--s-6);
    margin-top: auto;
  }

  ul {
    display: grid;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .btn {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 4rem;
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--glass-border);
    background: rgba(9, 16, 34, 0.55);
    border-radius: var(--glass-radius);
    color: var(--ink);
    font-size: var(--t-lg);
    font-variation-settings: 'wght' 620;
    text-decoration: none;
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      background-color 260ms var(--ease),
      color 260ms var(--ease);
  }

  .btn svg { flex: none; }
  .text { min-width: 0; overflow-wrap: anywhere; }

  .primary { font-size: var(--t-base); background: var(--accent); border-color: var(--accent); color: var(--paper); }

  /* Keyboard focus always shows. Hover only on devices that really hover:
     a phone keeps a tapped link "hovered", so it stayed lit after coming back. */
  .btn:focus-visible {
    background: var(--accent);
    color: var(--paper);
    transform: translate(-3px, -3px);
    box-shadow: 0 14px 40px rgba(243, 223, 174, 0.22);
    border-color: var(--accent);
  }
  @media (hover: hover) {
    .btn:hover {
      background: var(--accent);
      color: var(--paper);
      transform: translate(-3px, -3px);
      box-shadow: 0 14px 40px rgba(243, 223, 174, 0.22);
      border-color: var(--accent);
    }
    .btn:hover .arrow { transform: translate(3px, -3px); }
  }

  .arrow { margin-left: auto; transition: transform 260ms var(--ease-out); }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-6);
    font-size: var(--t-xs);
    color: var(--ink-faint);
  }

  /* Keep the address on one line on a phone. */
  @media (width < 40rem) {
    .primary { padding-inline: var(--s-4); gap: var(--s-2); font-size: 0.875rem; }
  }

  @media (width >= 40rem) {
    ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    li:first-child { grid-column: 1 / -1; }
  }

  @media (width >= 60rem) {
    ul { grid-template-columns: 2fr repeat(3, minmax(0, 1fr)); }
    li:first-child { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn, .arrow { transition: none; }
    .btn:hover, .btn:focus-visible { transform: none; }
  }
</style>
