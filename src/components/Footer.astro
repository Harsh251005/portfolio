---
/* Sitewide footer. Links live in one place — src/lib/links.ts —
   so they are never duplicated across pages. */
import { LINKS, OWNER } from '../lib/links';
---

<footer class="foot">
  <div class="page inner">
    <p class="name">{OWNER.name}</p>

    <nav aria-label="Elsewhere">
      <ul class="touch-list">
        {LINKS.map((link) => (
          <li>
            {link.href ? (
              <a href={link.href} rel={link.external ? 'noreferrer noopener me' : undefined}>
                {link.label}
              </a>
            ) : (
              <span class="todo" title="Add this in src/lib/links.ts">{link.label} ⟨missing⟩</span>
            )}
          </li>
        ))}
        <li><a href="/everything">Everything</a></li>
      </ul>
    </nav>

    <p class="year">{new Date().getFullYear()}</p>
  </div>
</footer>


<style>
  /* The footer is the one place on the page with no panel behind it,
     and it sits at the foot of the frame — which is exactly where the
     city is brightest. Left bare, the name and the links compete with
     lit windows. A scrim gives it the same ground every other block
     has without adding another backdrop-filter to the stack. */
  .foot {
    position: relative;
    padding-block: var(--s-6);
    margin-top: auto;
    isolation: isolate;
  }

  .foot::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklab, var(--paper-sunk) 82%, transparent) 38%,
      color-mix(in oklab, var(--paper-sunk) 94%, transparent)
    );
    /* Bleed past the footer so the fade starts above the rule rather
       than cutting across it. */
    margin-block-start: calc(var(--s-8) * -1);
    pointer-events: none;
  }

  .inner {
    border-top: var(--hairline) solid var(--rule);
    padding-top: var(--s-5);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    font-size: var(--t-sm);
  }

  a { color: var(--ink); }
  a:hover { color: var(--accent); }

  .year {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }
</style>
