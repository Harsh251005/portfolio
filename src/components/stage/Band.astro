---
/* A full-width horizontal band of the page.

   Owns two things and nothing else: which of the two surface tones
   it carries, and the vertical rhythm around it. Everything inside
   inherits the palette through custom properties, so no child
   component knows or cares which tone it is sitting on.

   Reordering the page is reordering these in index.astro. */

interface Props {
  tone?: 'deep' | 'soft';
  /** Drops the band's surface entirely so the field runs at full
   *  strength behind it. For the hero only. */
  clear?: boolean;
  /** How present the background field should be here, 0–1. Reading
   *  sections ask it to recede; the hero lets it run. */
  field?: number;
  id?: string;
  /** Removes the default vertical padding — for bands that manage
   *  their own, like the hero. */
  flush?: boolean;
  class?: string;
}

const {
  tone = 'deep',
  field = 1,
  clear = false,
  id,
  flush = false,
  class: extra = '',
} = Astro.props;
---

<section
  class:list={['band', `tone-${tone}`, { flush, clear }, extra]}
  id={id}
  data-tone={tone}
  data-field={field}
>
  <slot />
</section>

<style>
  .band {
    position: relative;
    /* Sits above the fixed field. The surface is *almost* opaque:
       enough of the field shows through for the page to feel alive,
       not enough to fight the text. The environment never gets to
       make the words harder to read. */
    z-index: 1;
    background: color-mix(in oklab, var(--paper) 93%, transparent);
    color: var(--ink);
    padding-block: var(--section);
  }

  .flush { padding-block: 0; }

  /* Hero only: no surface at all, the field runs clear. */
  .clear { background: transparent; }

  /* A hairline at every seam, in the incoming band's own rule colour,
     so the transition reads as deliberate rather than as two pages
     stacked. */
  .band + .band { border-top: 1px solid var(--rule-soft); }
</style>
