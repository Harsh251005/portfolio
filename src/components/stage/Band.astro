---
/* A full-width horizontal band of the page. Owns the vertical rhythm
   and an id, nothing else. Reordering the page is reordering these
   in index.astro. */

interface Props {
  id?: string;
  /** Removes the default vertical padding, for bands that manage
   *  their own, like the hero. */
  flush?: boolean;
  class?: string;
}

const { id, flush = false, class: extra = '' } = Astro.props;
---

<section class:list={['band', { flush }, extra]} id={id}>
  <slot />
</section>

<style>
  .band { padding-block: var(--section); }
  .flush { padding-block: 0; }
</style>
