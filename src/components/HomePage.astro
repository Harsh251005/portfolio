---
/* The page, as an ordered stack of bands: who, the person, the work, skills, education,
   how to reach me. Reordering the page means moving these blocks,
   nothing else. */
import Base from '../layouts/Base.astro';
import Band from './stage/Band.astro';
import Footer from './Footer.astro';

import Hero from './stage/Hero.svelte';
import About from './stage/About.svelte';
import Work from './stage/Work.svelte';
import Skills from './stage/Skills.svelte';
import Education from './stage/Education.svelte';
import Contact from './stage/Contact.svelte';

import { loadEntries } from '../lib/knowledge';
import { OWNER } from '../lib/links';

const entries = await loadEntries();
const projects = entries.filter((entry) => entry.card === 'project');

---

<Base title={`${OWNER.name} — ${OWNER.role}`} description={OWNER.tagline} path="/">
  <Band id="top" flush>
    <Hero client:load role={OWNER.role} location="Mumbai" status={OWNER.status} />
  </Band>

  <Band id="about">
    <About client:load />
  </Band>

  {/* Arriving from another page: deck fully spread (last card turns by 0.92, see Work.svelte). */}
  <Band id="work" land={0.96}>
    <Work client:load entries={projects} />
  </Band>

  <Band id="skills">
    <Skills client:load />
  </Band>

  <Band id="education">
    <Education client:load />
  </Band>

  <Band id="contact">
    <Contact client:visible />
  </Band>

  <Band flush>
    <Footer />
  </Band>
</Base>

<style is:global>
  body { display: flex; flex-direction: column; }
</style>
