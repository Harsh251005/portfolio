---
/* The body of one entry, without JavaScript.

   Used by /ask/[slug], which owns the page heading, the panel and the
   diagram. This renders what goes inside: the story, the list rows and
   any folded extras, in the same visual language as the home page. */
import type { Entry } from '../lib/brain/types';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;

/** Marks ⟨draft⟩ text the same way the Markdown pipeline does. */
function mark(text: string) {
  return text
    .split(/(⟨[^⟩]*⟩)/g)
    .filter(Boolean)
    .map((part) => (part.startsWith('⟨') ? `<span class="todo">${part}</span>` : part))
    .join('');
}

/* A list's intro reads before its rows, but a folded "more" block
   belongs after them. Split the body at the first fold. */
const fold = entry.html.indexOf('<details class="more"');
const lead = fold === -1 ? entry.html : entry.html.slice(0, fold);
const rest = fold === -1 ? '' : entry.html.slice(fold);
---

<div class="answer">
  {entry.moment && <p class="moment">{entry.moment}</p>}
  {entry.plain && <p class="plain" set:html={mark(entry.plain)} />}

  {lead && <div class="prose" set:html={lead} />}

  {entry.items?.length && (
    <ol class="rows">
      {entry.items.map((item, i) => (
        <li>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2>{item.label}</h2>
            {item.body && <p set:html={mark(item.body)} />}
          </div>
        </li>
      ))}
    </ol>
  )}

  {rest && <div class="prose" set:html={rest} />}
</div>

<style>
  .moment {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-style: italic;
    font-variation-settings: 'opsz' var(--opsz-display), 'wght' 350;
    line-height: var(--leading-snug);
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .plain {
    margin-top: var(--s-4);
    font-size: var(--t-lg);
    line-height: var(--leading-snug);
    color: var(--ink);
    max-width: 44ch;
  }

  .moment + .plain + .prose,
  .plain + .prose { margin-top: var(--s-6); }

  /* Section headings inside a long story: each part gets a
     rule and room above it, so the page reads as chapters. */
  .prose :global(h2) {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    font-size: var(--t-xl);
    color: var(--ink);
  }

  .prose > :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }

  /* Same ruled list with outlined numerals as How I work on the home
     page, so a reader moving between the two sees one design. */
  .rows {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .rows li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .n {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-variation-settings: 'opsz' var(--opsz-display), 'wght' 300;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .rows h2 {
    font-size: var(--t-lg);
    font-variation-settings: 'opsz' var(--opsz-text), 'wght' 450;
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
  }

  .rows p {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 50ch;
  }

  .rows + .prose { margin-top: var(--s-5); }

  @media (width < 40rem) {
    .rows li { grid-template-columns: 3.5rem 1fr; }
  }
</style>
